---
interface Props {
  title: string;
  description: string;
  actionHref?: string;
  actionLabel?: string;
}
const { title, description, actionHref, actionLabel } = Astro.props;
---
<section class="hero section-shell">
  <h1>{title}</h1>
  <p class="hero-description">{description}</p>
  {actionHref && actionLabel && <a class="button button-primary" href={actionHref}>{actionLabel}</a>}
</section>
