---
import type { DidactivApp } from '../data/apps';
import StoreButtons from './StoreButtons.astro';

interface Props { app: DidactivApp }
const { app } = Astro.props;
---
<article class="app-card">
  <div class="app-card-icon"><img src={app.icon} alt={app.iconAlt} width="72" height="72" /></div>
  <div class="app-card-content">
    <p class="eyebrow">Aplicație Didactiv</p>
    <h3>{app.name}</h3>
    <p class="app-tagline">{app.tagline}</p>
    <p>{app.description}</p>
    <a class="text-link" href={`/${app.slug}/`}>Descoperă {app.name} <span aria-hidden="true">→</span></a>
    <StoreButtons stores={app.stores} />
  </div>
</article>
