---
import type { DidactivApp } from '../data/apps';
import PhoneFrame from './PhoneFrame.astro';
import StoreButtons from './StoreButtons.astro';

interface Props { app: DidactivApp }
const { app } = Astro.props;
const previewImage = app.previewImage ?? app.games[0]?.image;
const previewAlt = app.previewImageAlt ?? app.games[0]?.imageAlt ?? `Captură din ${app.name}`;
---
<article class="app-card">
  <div class="app-card-content">
    <h2>{app.name}</h2>
    <p class="app-tagline">{app.tagline}</p>
    <p>{app.description}</p>
    <StoreButtons stores={app.stores} />
  </div>
  {previewImage && (
    <div class="app-card-preview">
      <PhoneFrame src={previewImage} alt={previewAlt} loading="eager" />
    </div>
  )}
</article>
