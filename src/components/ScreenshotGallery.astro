---
import type { Game } from '../data/apps';
import PhoneFrame from './PhoneFrame.astro';
interface Props { games: Game[] }
const { games } = Astro.props;
---
<div class="screenshot-gallery">
  {games.map((game) => (
    <figure class="screenshot-card">
      {game.image ? (
        <PhoneFrame src={game.image} alt={game.imageAlt ?? `Captură pentru ${game.title}`} />
      ) : (
        <div class="screenshot-placeholder" role="img" aria-label={`Captură pentru ${game.title} indisponibilă`}>Captură indisponibilă</div>
      )}
      <figcaption>{game.title}</figcaption>
    </figure>
  ))}
</div>
