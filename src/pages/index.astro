---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import { apps } from '../data/apps';
---
<BaseLayout
  title="Didactiv — aplicații educative simple și atente"
  description="Didactiv creează aplicații educative simple și atente. Descoperă Slove, primul nostru proiect."
  path="/"
>
  <h1 class="sr-only">Didactiv — aplicații educative simple și atente</h1>
  <section class="section-shell section-block app-showcase" aria-label="Aplicații Didactiv">
    <div class="app-list">
      {apps.map((app) => <AppCard app={app} />)}
    </div>
  </section>
</BaseLayout>
