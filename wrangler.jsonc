{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "didactiv-ro",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "didactiv.ro", "custom_domain": true },
    { "pattern": "www.didactiv.ro", "custom_domain": true }
  ]
}
