---
import type { Game } from '../data/apps';

interface Props { games: Game[] }
const { games } = Astro.props;
---
<section class="app-card games-slide" id="jocuri" aria-labelledby="games-title">
  <div class="games-slide-content">
    <h2 id="games-title">Jocurile Slove</h2>
    <div class="home-game-grid">
      {games.map((game, index) => (
        <article class={`home-game-card home-game-card-${index + 1}`}>
          <p class="home-game-number">{String(index + 1).padStart(2, '0')}</p>
          <h3>{game.title}</h3>
          <p>{game.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
